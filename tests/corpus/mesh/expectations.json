    },
    {
      "_why": "The declared triangle count is validated against the file length before any triangle is read, so truncation is a specific error rather than garbage geometry.",
      "file": "broken-truncated.stl", "units": "mm", "load": "reject",
      "error_contains": "truncated"
    },
    {
      "_why": "A header claiming 999 triangles in a 684-byte file. The error must name the count, which is why format detection treats a NUL-bearing .stl as binary even when its length check fails.",
      "file": "broken-wrong-count.stl", "units": "mm", "load": "reject",
      "error_contains": "999"
    },
